<?xml version="1.0" encoding="utf-8"?>
<!-- IsoRim Waylith - Combat Extended Pack: vanilla guns and grenades CE redraws keep CE's art.
     CE replaces the sprites of these vanilla weapons (its Textures/Things/Item/Equipment/WeaponRanged at the vanilla paths;
     the grenades: texPath moved to its HandGrenades art) but keeps their defNames, so IsoRim's models made for the vanilla
     sprites would still bind to them. Their ModelDefs are removed: each weapon falls back to its own (CE) sprite made
     solid, as every weapon without a model. A ModelDef that is not there (another IsoRim version) is skipped quietly. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/IsoRim.ModelDef[thingDef="Gun_AssaultRifle"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/IsoRim.ModelDef[thingDef="Gun_AssaultRifle"]</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/IsoRim.ModelDef[thingDef="Gun_Autopistol"]</xpath>
